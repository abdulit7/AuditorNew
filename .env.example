# --- Server ---
NODE_ENV=production
PORT=3001
# Number of reverse proxies in front (nginx/Caddy/Cloudflare tunnel = 1) so client IPs and rate limits are right
TRUST_PROXY=1

# --- Database (MySQL 8) ---
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auditgrid
DB_PASSWORD=change-me
DB_NAME=auditgrid
# For a single-box/dev install without MySQL: DB_CLIENT=better-sqlite3 and SQLITE_FILE=./data/auditgrid.sqlite

# --- Security ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# Must be true behind HTTPS (required in production)
COOKIE_SECURE=true
# Only needed if the SPA is served from a different origin than the API
CORS_ORIGINS=

# --- First administrator (created once, only when the users table is empty) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=

# Dev only: loads demo geography/users/reports (public demo passwords). Refused in production.
SEED_DEMO=false

# --- docker-compose only ---
DOMAIN=audit.example.com
MYSQL_ROOT_PASSWORD=

# Google Maps JavaScript API browser key (optional). Without it the app still works; maps show a list with
# "Directions" links instead. Restrict the key to your website address (HTTP referrers) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
